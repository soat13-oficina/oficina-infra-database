# Copie para backend.hcl (gitignored) e ajuste com o bucket do grupo:
#   terraform init -backend-config=backend.hcl
#
# Use a MESMA bucket dos demais repositorios - este repositorio precisa ler o
# state da plataforma (oficina/infra-k8s.tfstate) de dentro dela.
bucket = "SEU-BUCKET-DE-STATE-AQUI"
region = "us-east-1"
